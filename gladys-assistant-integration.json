{
  "manifest_version": 1,
  "type": "device",
  "name": "Firefly III",
  "description": {
    "en": "Balances, budgets, bills and piggy banks of your Firefly III in Gladys.",
    "fr": "Soldes, budgets, factures et tirelires de votre Firefly III dans Gladys.",
    "de": "Kontostände, Budgets, Rechnungen und Sparschweine deines Firefly III in Gladys.",
    "es": "Saldos, presupuestos, facturas y huchas de su Firefly III en Gladys."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-firefly:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-firefly/main/cover.png",
  "categories": ["services"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connection to Firefly III",
        "fr": "Connexion à Firefly III",
        "de": "Verbindung zu Firefly III",
        "es": "Conexión con Firefly III"
      },
      "description": {
        "en": "In Firefly III, open Options → Profile → OAuth, create a personal access token and paste it below with the address of Firefly III. Then add the accounts, budgets and bills you want in the Discover tab.",
        "fr": "Dans Firefly III, ouvrez Options → Profil → OAuth, créez un jeton d'accès personnel et collez-le ci-dessous avec l'adresse de Firefly III. Ajoutez ensuite les comptes, budgets et factures voulus dans l'onglet Découverte.",
        "de": "Öffne in Firefly III Optionen → Profil → OAuth, erstelle ein persönliches Zugriffstoken und füge es unten mit der Adresse von Firefly III ein. Füge dann die gewünschten Konten, Budgets und Rechnungen im Tab „Entdecken“ hinzu.",
        "es": "En Firefly III, abra Opciones → Perfil → OAuth, cree un token de acceso personal y péguelo abajo con la dirección de Firefly III. Después añada las cuentas, presupuestos y facturas que desee en la pestaña Descubrir."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-firefly/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Installationsanleitung",
            "es": "Guía de instalación"
          }
        },
        {
          "url": "https://docs.firefly-iii.org/how-to/firefly-iii/features/api/",
          "label": {
            "en": "Firefly III API tokens",
            "fr": "Jetons d'API de Firefly III",
            "de": "API-Tokens von Firefly III",
            "es": "Tokens de API de Firefly III"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "Address of Firefly III",
        "fr": "Adresse de Firefly III",
        "de": "Adresse von Firefly III",
        "es": "Dirección de Firefly III"
      },
      "description": {
        "en": "The address you open Firefly III with, reachable from Gladys.",
        "fr": "L'adresse à laquelle vous ouvrez Firefly III, joignable depuis Gladys.",
        "de": "Die Adresse, unter der du Firefly III öffnest, von Gladys aus erreichbar.",
        "es": "La dirección con la que abre Firefly III, accesible desde Gladys."
      },
      "placeholder": {
        "en": "e.g. http://192.168.1.20:8080",
        "fr": "ex. http://192.168.1.20:8080",
        "de": "z. B. http://192.168.1.20:8080",
        "es": "p. ej. http://192.168.1.20:8080"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "token",
      "type": "secret",
      "label": {
        "en": "Personal access token",
        "fr": "Jeton d'accès personnel",
        "de": "Persönliches Zugriffstoken",
        "es": "Token de acceso personal"
      },
      "description": {
        "en": "Read only by this integration: it never writes to Firefly III. Stored by Gladys, never written to the logs.",
        "fr": "Lu seulement par cette intégration : elle n'écrit jamais dans Firefly III. Gardé par Gladys, jamais écrit dans les journaux.",
        "de": "Wird nur von dieser Integration gelesen, die nie in Firefly III schreibt. Von Gladys gespeichert, nie in die Protokolle geschrieben.",
        "es": "Solo lo lee esta integración: nunca escribe en Firefly III. Guardado por Gladys, nunca escrito en los registros."
      },
      "required": true
    },
    {
      "key": "allow_self_signed",
      "type": "boolean",
      "label": {
        "en": "Accept a self-signed certificate",
        "fr": "Accepter un certificat auto-signé",
        "de": "Selbstsigniertes Zertifikat akzeptieren",
        "es": "Aceptar un certificado autofirmado"
      },
      "description": {
        "en": "Only for an https address whose certificate you made yourself.",
        "fr": "Seulement pour une adresse https dont vous avez fait le certificat vous-même.",
        "de": "Nur für eine https-Adresse, deren Zertifikat du selbst erstellt hast.",
        "es": "Solo para una dirección https cuyo certificado haya creado usted mismo."
      },
      "required": false,
      "default": false
    },
    {
      "key": "refresh_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Fréquence de mise à jour",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often Firefly III is read. Your money does not move by the second: 15 minutes is plenty.",
        "fr": "Fréquence de lecture de Firefly III. Votre argent ne bouge pas à la seconde : 15 minutes suffisent.",
        "de": "Wie oft Firefly III gelesen wird. Dein Geld bewegt sich nicht sekündlich: 15 Minuten reichen.",
        "es": "Frecuencia de lectura de Firefly III. Su dinero no se mueve cada segundo: 15 minutos bastan."
      },
      "required": false,
      "default": "15",
      "options": [
        {
          "value": "5",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "10 minutes",
            "fr": "10 minutes",
            "de": "10 Minuten",
            "es": "10 minutos"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "15 minutes",
            "fr": "15 minutes",
            "de": "15 Minuten",
            "es": "15 minutos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 minutes",
            "fr": "30 minutes",
            "de": "30 Minuten",
            "es": "30 minutos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "60 minutes",
            "fr": "60 minutes",
            "de": "60 Minuten",
            "es": "60 minutos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Names of the features (at their creation) and texts sent to the scenes.",
        "fr": "Noms des fonctionnalités (à leur création) et textes envoyés aux scènes.",
        "de": "Namen der Funktionen (bei ihrer Erstellung) und Texte für die Szenen.",
        "es": "Nombres de las funciones (al crearlas) y textos enviados a las escenas."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "check_now",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "bill_due",
      "label": {
        "en": "Firefly III: bill due soon",
        "fr": "Firefly III : facture à échéance",
        "de": "Firefly III: Rechnung bald fällig",
        "es": "Firefly III: factura próxima"
      },
      "description": {
        "en": "A bill of Firefly III is expected in the chosen number of days. Once per bill, due date and number of days.",
        "fr": "Une facture de Firefly III est attendue dans le nombre de jours choisi. Une fois par facture, échéance et nombre de jours.",
        "de": "Eine Rechnung von Firefly III wird in der gewählten Anzahl Tage erwartet. Einmal pro Rechnung, Fälligkeit und Anzahl Tage.",
        "es": "Se espera una factura de Firefly III en el número de días elegido. Una vez por factura, vencimiento y número de días."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Bill",
            "fr": "Facture",
            "de": "Rechnung",
            "es": "Factura"
          }
        },
        {
          "key": "days",
          "type": "select",
          "required": true,
          "default": "3",
          "label": {
            "en": "Due in",
            "fr": "Échéance dans",
            "de": "Fällig in",
            "es": "Vence en"
          },
          "options": [
            {
              "value": "0",
              "label": {
                "en": "The day itself",
                "fr": "Le jour même",
                "de": "Am selben Tag",
                "es": "El mismo día"
              }
            },
            {
              "value": "1",
              "label": {
                "en": "1 day",
                "fr": "1 jour",
                "de": "1 Tag",
                "es": "1 día"
              }
            },
            {
              "value": "2",
              "label": {
                "en": "2 days",
                "fr": "2 jours",
                "de": "2 Tage",
                "es": "2 días"
              }
            },
            {
              "value": "3",
              "label": {
                "en": "3 days",
                "fr": "3 jours",
                "de": "3 Tage",
                "es": "3 días"
              }
            },
            {
              "value": "7",
              "label": {
                "en": "7 days",
                "fr": "7 jours",
                "de": "7 Tage",
                "es": "7 días"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Bill name",
            "fr": "Nom de la facture",
            "de": "Name der Rechnung",
            "es": "Nombre de la factura"
          }
        },
        {
          "key": "amount",
          "type": "number",
          "label": {
            "en": "Expected amount",
            "fr": "Montant prévu",
            "de": "Erwarteter Betrag",
            "es": "Importe previsto"
          }
        },
        {
          "key": "currency",
          "type": "string",
          "label": {
            "en": "Currency (EUR, USD…)",
            "fr": "Devise (EUR, USD…)",
            "de": "Währung (EUR, USD…)",
            "es": "Divisa (EUR, USD…)"
          }
        },
        {
          "key": "due_date",
          "type": "string",
          "label": {
            "en": "Due date (YYYY-MM-DD)",
            "fr": "Échéance (AAAA-MM-JJ)",
            "de": "Fälligkeit (JJJJ-MM-TT)",
            "es": "Vencimiento (AAAA-MM-DD)"
          }
        },
        {
          "key": "text",
          "type": "string",
          "label": {
            "en": "Sentence to send or read",
            "fr": "Phrase à envoyer ou à lire",
            "de": "Satz zum Senden oder Vorlesen",
            "es": "Frase para enviar o leer"
          }
        }
      ]
    },
    {
      "key": "budget_threshold",
      "label": {
        "en": "Firefly III: budget level reached",
        "fr": "Firefly III : seuil de budget atteint",
        "de": "Firefly III: Budgetschwelle erreicht",
        "es": "Firefly III: umbral de presupuesto alcanzado"
      },
      "description": {
        "en": "The spending of a budget reaches the chosen share of its amount (100 %: budget used up or exceeded). Once per level and per period.",
        "fr": "Les dépenses d'un budget atteignent la part choisie de son montant (100 % : budget épuisé ou dépassé). Une fois par seuil et par période.",
        "de": "Die Ausgaben eines Budgets erreichen den gewählten Anteil seines Betrags (100 %: Budget aufgebraucht oder überschritten). Einmal pro Schwelle und Zeitraum.",
        "es": "El gasto de un presupuesto alcanza la parte elegida de su importe (100 %: presupuesto agotado o superado). Una vez por umbral y por periodo."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Budget",
            "fr": "Budget",
            "de": "Budget",
            "es": "Presupuesto"
          }
        },
        {
          "key": "level",
          "type": "select",
          "required": true,
          "default": "90",
          "label": {
            "en": "Level reached",
            "fr": "Seuil atteint",
            "de": "Erreichte Schwelle",
            "es": "Umbral alcanzado"
          },
          "options": [
            {
              "value": "50",
              "label": {
                "en": "50 %",
                "fr": "50 %",
                "de": "50 %",
                "es": "50 %"
              }
            },
            {
              "value": "75",
              "label": {
                "en": "75 %",
                "fr": "75 %",
                "de": "75 %",
                "es": "75 %"
              }
            },
            {
              "value": "90",
              "label": {
                "en": "90 %",
                "fr": "90 %",
                "de": "90 %",
                "es": "90 %"
              }
            },
            {
              "value": "100",
              "label": {
                "en": "100 %",
                "fr": "100 %",
                "de": "100 %",
                "es": "100 %"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Budget name",
            "fr": "Nom du budget",
            "de": "Name des Budgets",
            "es": "Nombre del presupuesto"
          }
        },
        {
          "key": "spent",
          "type": "number",
          "label": {
            "en": "Spent",
            "fr": "Dépensé",
            "de": "Ausgegeben",
            "es": "Gastado"
          }
        },
        {
          "key": "limit",
          "type": "number",
          "label": {
            "en": "Budgeted",
            "fr": "Budgété",
            "de": "Budgetiert",
            "es": "Presupuestado"
          }
        },
        {
          "key": "percent",
          "type": "number",
          "label": {
            "en": "Budget used (%)",
            "fr": "Budget consommé (%)",
            "de": "Budget verbraucht (%)",
            "es": "Presupuesto consumido (%)"
          }
        },
        {
          "key": "currency",
          "type": "string",
          "label": {
            "en": "Currency (EUR, USD…)",
            "fr": "Devise (EUR, USD…)",
            "de": "Währung (EUR, USD…)",
            "es": "Divisa (EUR, USD…)"
          }
        },
        {
          "key": "text",
          "type": "string",
          "label": {
            "en": "Sentence to send or read",
            "fr": "Phrase à envoyer ou à lire",
            "de": "Satz zum Senden oder Vorlesen",
            "es": "Frase para enviar o leer"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "read_balances",
      "label": {
        "en": "Firefly III: read the balances",
        "fr": "Firefly III : lire les soldes",
        "de": "Firefly III: Kontostände lesen",
        "es": "Firefly III: leer los saldos"
      },
      "description": {
        "en": "The balance of every account added to Gladys, as a sentence to send by message or read aloud.",
        "fr": "Le solde de chaque compte ajouté à Gladys, en une phrase à envoyer par message ou à lire à voix haute.",
        "de": "Der Stand jedes zu Gladys hinzugefügten Kontos, als Satz zum Senden per Nachricht oder zum Vorlesen.",
        "es": "El saldo de cada cuenta añadida a Gladys, en una frase para enviar por mensaje o leer en voz alta."
      },
      "timeout_seconds": 60,
      "outputs": [
        {
          "key": "text",
          "type": "string",
          "label": {
            "en": "Sentence to send or read",
            "fr": "Phrase à envoyer ou à lire",
            "de": "Satz zum Senden oder Vorlesen",
            "es": "Frase para enviar o leer"
          }
        },
        {
          "key": "count",
          "type": "number",
          "label": {
